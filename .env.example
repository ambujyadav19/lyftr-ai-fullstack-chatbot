# ==========================================
# Backend Configuration
# ==========================================

# Comma-separated key pool, at least 2 keys. Key ids are key_1, key_2, ... in this order.
LLM_API_KEYS=your_primary_api_key_here,your_fallback_api_key_here

# SQLite database location mounted to docker volume or local path
DATABASE_URL=sqlite:////data/app.db

# Comma-separated CORS origins
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Set to true to enable the failover test hook (X-Simulate-Failure header)
ENABLE_FAILURE_SIMULATION=true

# Model name supported by LiteLLM (e.g., gemini/gemini-2.0-flash, gpt-4o-mini, groq/llama-3.3-70b-versatile)
MODEL_NAME=gemini/gemini-2.0-flash

# Default system prompt for sessions
DEFAULT_SYSTEM_PROMPT=You are a helpful and concise AI assistant.

# ==========================================
# Frontend Configuration
# ==========================================

# Target backend API base URL
VITE_API_BASE_URL=http://localhost:8000
